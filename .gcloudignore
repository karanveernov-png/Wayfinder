# Files/directories to ignore when deploying to Google Cloud
# https://cloud.google.com/sdk/gcloud/reference/topic/gcloudignore

# Version control
.git
.gitignore

# Local development
.env
.env.local
.env.production
backend/.env
frontend/.env
.venv
venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
*.egg-info/
.eggs/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Documentation (not needed for deployment)
*.md
!README.md
DEPLOYMENT.md

# Test files
tests/
*.test.js

# Docker
docker-compose.yml
.dockerignore

# CI/CD
.github/

# Supabase setup
SUPABASE_SETUP.md

# Python cache
*.py[cod]
*$py.class
*.so
.Python

# Temporary files
*.tmp
*.temp
.tmp/
temp/