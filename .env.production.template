# Waymark -- Frontend Environment Variables Template  
# Copy this file to .env.production and fill in real values before building/deploying.  
# NEVER commit the filled version to git.  
  
# Backend API base URL (no trailing slash)  
VITE_API_BASE_URL=https://your-backend-url.onrender.com/api/v1  
  
# Supabase project credentials  
VITE_SUPABASE_URL=https://your-project.supabase.co  
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key  
  
# MapTiler API key (required for map tiles)  
VITE_MAPTILER_API_KEY=your-maptiler-key 
