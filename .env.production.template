# ── Production Environment Template ─────────────────────────────────────
# Copy this to .env.production and fill in real values before deploying.
# Never commit the filled-in version to git (it contains secrets).
#
# Quick reference:
#   backend/.env.example          — full list with descriptions
#   SUPABASE_JWT_SECRET           — Dashboard → Settings → API → JWT Settings
#   VITE_API_BASE_URL             — your deployed backend URL + /api/v1
#   VITE_SUPABASE_URL / ANON_KEY  — same project you're deploying auth against
#   HTTP_USER_AGENT               — your project name + contact email/URL

# ===== API configuration ====================================================

APP_ENV=production

# CORS: origin of your deployed frontend (exact scheme+host, no trailing slash).
# Add multiple origins separated by commas if needed.
CORS_ORIGINS=https://your-app-name.onrender.com

# ===== Supabase Auth (saved journeys) =======================================

SUPABASE_URL=https://wxmvhqjxrseamshacynj.supabase.co
SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>

# ⚠️ REQUIRED for saved-journeys to work at all
SUPABASE_JWT_SECRET=<COPY_FROM_SUPABASE_DASHBOARD_JWT_SETTINGS>

# ===== External provider URLs (all free/keyless, leave defaults unless you change providers) =

GEOCODING_PROVIDER_URL=https://nominatim.openstreetmap.org
ROUTING_PROVIDER_URL=https://router.project-osrm.org
FACILITY_PROVIDER_URL=https://overpass-api.de/api/interpreter
WEATHER_PROVIDER_URL=https://api.open-meteo.com
ALERT_PROVIDER_URL=https://eonet.gsfc.nasa.gov/api/v3
ALERT_DAYS_LOOKBACK=20

# ===== Nominatim rate-limiting (keep at 1.0+ for production) ================

HTTP_USER_AGENT=wayfinder-backend/1.0 (<your-contact-email-or-project-url>)
NOMINATIM_MIN_INTERVAL_SECONDS=1.0

# ===== AI trip-planning (optional) ==========================================

GROQ_API_KEY=<YOUR_GROQ_API_KEY>
# Leave blank to disable AI trip planning (feature reports "not configured")
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REQUEST_TIMEOUT_SECONDS=15

# ===== Request timeouts =====================================================

REQUEST_TIMEOUT_SECONDS=10

# ===== Backend-facing environment variables only ============================

ISRO_BHUVAN_TOKEN=
ALERT_PROVIDER_KEY=
GEOCODING_PROVIDER_KEY=
ROUTING_PROVIDER_KEY=
FACILITY_PROVIDER_KEY=
WEATHER_PROVIDER_KEY=
